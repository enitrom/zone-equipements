rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'enitrom@gmail.com' ||
        request.auth.token.email == 'tinemor89@gmail.com'
      );
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      match /cart/{cartItemId} {
        allow read, write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if true;
    }

    match /suppliers/{supplierId} {
      allow read: if true;
      allow write: if true;
    }

    match /agent_warehouses/{warehouseId} {
      allow read: if true;
      allow write: if true;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow write: if true;
    }

    match /supplier_tokens/{tokenId} {
      allow read: if true;
      allow write: if true;
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    match /{document=**} {
      allow read, write: if true;
    }
  }
}

